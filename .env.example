# ---------------------------------------------------------------------------
# Enterprise RAG Platform - environment template
# Copy this file to .env and fill in real values. Never commit .env.
# ---------------------------------------------------------------------------

# Database (the Docker stack overrides DB_HOST/DB_PORT internally)
DB_NAME=enterprise_rag_db
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Django
DJANGO_SECRET_KEY=generate-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_LOG_LEVEL=INFO

# JWT (access tokens used to expire after 5 minutes)
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# Redis / Celery
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

# AI inference service
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_CONNECT_TIMEOUT=10
AI_SERVICE_READ_TIMEOUT=120
AI_SERVICE_LLM_READ_TIMEOUT=600
AI_SERVICE_MAX_RETRIES=2

# Models. Set AI_ENABLE_RERANKER=0 on low-memory machines.
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
RERANKER_MODEL_NAME=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
AI_ENABLE_RERANKER=1
AI_TORCH_THREADS=2
AI_MODEL_LOAD_TIMEOUT=180
# Set to 1 to forbid any HuggingFace network access (models must be cached).
AI_OFFLINE=0

# LLM provider: "ollama" or "openai_compatible"
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/api
LLM_MODEL=qwen2.5:3b
LLM_API_KEY=

# Optional error reporting
SENTRY_DSN=
SENTRY_FASTAPI_DSN=
SENTRY_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# RAG evaluation (quality / hallucination measurement)
# ---------------------------------------------------------------------------

# Backend: "internal" (built in, always available) or "ragas" (requires
# `pip install ragas langchain-ollama` inside the ai_service image).
AI_EVAL_BACKEND=internal

# Shared secret for the internal /api/eval/* endpoints. Empty = open
# (acceptable only because the service is internal).
AI_EVAL_TOKEN=

# Default retrieval scope, so the CLI can run without arguments.
# Fill these with the ids printed by `seed_evaluation_corpus`.
AI_EVAL_TENANT_ID=
AI_EVAL_DEPARTMENT_IDS=

# Comma separated subset of:
# faithfulness, answer_relevancy, context_precision, answer_correctness
AI_EVAL_METRICS=
AI_EVAL_TOP_K=5

# Judge settings. A CPU-only 3B model needs a generous timeout.
AI_EVAL_JUDGE_TIMEOUT=180
AI_EVAL_JUDGE_RETRIES=1
# 1 = ask the judge to split the answer into statements (RAGAS default).
# 0 = deterministic sentence splitting, more reliable with small models.
AI_EVAL_LLM_DECOMPOSITION=0

# Cap the number of samples per run (0 = whole dataset).
AI_EVAL_MAX_SAMPLES=0

# Periodic runs. 0 disables the scheduler.
AI_EVAL_SCHEDULE_HOURS=0
AI_EVAL_SCHEDULE_LIMIT=10

# Acceptance thresholds used to compute summary.passed
AI_EVAL_MIN_FAITHFULNESS=0.80
AI_EVAL_MIN_ANSWER_RELEVANCY=0.70
AI_EVAL_MIN_CONTEXT_PRECISION=0.60

# How many report files to keep on the eval_reports volume.
AI_EVAL_KEEP_REPORTS=30

# Shared secret between Django and the AI service.
# Generate one with: python -c "import secrets;print(secrets.token_hex(32))"
# Leave empty only for a single-machine development run.
AI_INTERNAL_TOKEN=
